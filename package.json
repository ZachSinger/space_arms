{
  "name": "space-arms-dealer",
  "version": "1.0.0",
  "description": "Space Arms Dealer Simulator",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "package": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.zachsinger.spacearmsdealer",
    "productName": "Space Arms Dealer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json",
      "dist/**/*"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.18.0",
    "phaser": "^3.80.1",
    "vite": "^5.4.1"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
